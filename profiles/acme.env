# A second, differently named copy of the runtime + gateway + target, from the same templates.
#
# Why this file exists: the templates take every name as a parameter. Deploying them again
# under different names, without editing a single line of YAML, is what proves it. Copy this
# file and edit the names to make the deployment your own.
#
# Source it BEFORE deploy.sh so these values win over config.env, which reads every setting
# as ${VAR:-default}:
#
#   source profiles/acme.env && ./deploy.sh --only runtime --only gateway --only target
#
# The shared layers - data lake, roles, Lake Formation, ECR, interceptor - are deliberately
# NOT overridden. They are reused, so this adds one runtime, one gateway, one target and one
# credential provider, and nothing else.

# Resource names. Runtimes allow only letters, digits and underscores; gateways and targets
# allow hyphens, which is why these two look different.
export RUNTIME_NAME="mcp_runtime_acme"
export GATEWAY_NAME="mcp-gateway-acme"
export GATEWAY_TARGET_NAME="athena-mcp-acme"

# Separate stacks, so the first deployment is untouched and the two can be compared side by
# side.
export STACK_RUNTIME="acme-mcp-runtime"
export STACK_GATEWAY="acme-mcp-gateway"
export STACK_TARGET="acme-mcp-target"

# A provider of its own, created BY the target stack. Leaving OKTA_OBO_PROVIDER_ARN empty is
# what selects that path; setting it adopts a provider that already exists outside
# CloudFormation instead.
export OKTA_OBO_PROVIDER="acme-okta-obo"
export OKTA_OBO_PROVIDER_ARN=""

# Note: outputs.json is shared, and the okta_* keys are written by whichever of the two
# deployments ran last. That is why the stack names above are distinct - the stacks, not the
# outputs file, are the source of truth. Re-point outputs.json at either one with:
#   source scripts/lib.sh && cfn_export_outputs acme-mcp-gateway
