# Deployment target and shared naming. Sourced by deploy.sh and the scripts.
export AWS_PROFILE="${AWS_PROFILE:-default}"
export AWS_REGION="${AWS_REGION:-us-west-2}"

# The account number and the deploying principal are resolved from STS at run time
# rather than committed, so nothing here carries an account identifier or an IAM user
# name. Pin either value in the environment to skip the lookup -- required when the
# caller is an SSO session, whose IAM role path cannot be recovered from the session
# ARN.
#
# ACCOUNT_ID_SOURCE records whether the value was pinned or looked up, which is what
# keeps preflight's account guard meaningful: comparing an STS-derived value against
# STS proves nothing, so the guard only asserts when the account was pinned
# deliberately.
if [ -n "${ACCOUNT_ID:-}" ]; then
  export ACCOUNT_ID_SOURCE="env"
else
  export ACCOUNT_ID_SOURCE="sts"
fi

if [ -z "${ACCOUNT_ID:-}" ] || [ -z "${LF_ADMIN_ARN:-}" ]; then
  if ! _caller="$(aws --profile "${AWS_PROFILE}" --region "${AWS_REGION}" \
                   sts get-caller-identity --query '[Account,Arn]' --output text 2>&1)"; then
    echo "config.env: sts get-caller-identity failed for profile '${AWS_PROFILE}':" >&2
    echo "  ${_caller}" >&2
    echo "Log in, or export ACCOUNT_ID and LF_ADMIN_ARN yourself." >&2
    return 1 2>/dev/null || exit 1
  fi
  export ACCOUNT_ID="${ACCOUNT_ID:-$(printf '%s' "${_caller}" | awk '{print $1}')}"

  if [ -z "${LF_ADMIN_ARN:-}" ]; then
    _arn="$(printf '%s' "${_caller}" | awk '{print $2}')"
    # Lake Formation names admins by IAM ARN, never by the STS assumed-role ARN a
    # session presents, so a role session has to be translated back. SSO roles live
    # under /aws-reserved/sso.amazonaws.com/<region>/ and that path is absent from
    # the session ARN, so there is nothing to translate -- ask for it explicitly
    # instead of writing an ARN that Lake Formation will reject.
    case "${_arn}" in
      *:assumed-role/AWSReservedSSO_*)
        echo "config.env: caller is an SSO session:" >&2
        echo "  ${_arn}" >&2
        echo "Export LF_ADMIN_ARN as the IAM role ARN, including its /aws-reserved/... path." >&2
        return 1 2>/dev/null || exit 1 ;;
      *:assumed-role/*)
        _arn="arn:aws:iam::${ACCOUNT_ID}:role/$(printf '%s' "${_arn}" | cut -d/ -f2)" ;;
    esac
    export LF_ADMIN_ARN="${_arn}"
    unset _arn
  fi
  unset _caller
fi

# --- naming ------------------------------------------------------------------
# One knob. Every resource name derives from it, so the same templates deploy any
# number of times in one account. Use lowercase letters, digits and hyphens; keep it
# short. The underscore variant is used for names that reject hyphens: the Glue
# database, the Athena workgroup and the AgentCore Runtime.
export PREFIX="${PREFIX:-mcp}"
_PREFIX_="$(printf '%s' "${PREFIX}" | tr - _)"

export GLUE_DATABASE="${GLUE_DATABASE:-${_PREFIX_}_demo}"
export ATHENA_WORKGROUP="${ATHENA_WORKGROUP:-${_PREFIX_}_workgroup}"
export DATA_BUCKET="${DATA_BUCKET:-${PREFIX}-data-${ACCOUNT_ID}-${AWS_REGION}}"

export ANALYTICS_ROLE_NAME="${ANALYTICS_ROLE_NAME:-${PREFIX}-analytics-role}"
export BUSINESS_ROLE_NAME="${BUSINESS_ROLE_NAME:-${PREFIX}-business-role}"
export RUNTIME_EXEC_ROLE_NAME="${RUNTIME_EXEC_ROLE_NAME:-${PREFIX}-runtime-exec-role}"
export GATEWAY_ROLE_NAME="${GATEWAY_ROLE_NAME:-${PREFIX}-gateway-role}"
export INTERCEPTOR_ROLE_NAME="${INTERCEPTOR_ROLE_NAME:-${PREFIX}-interceptor-role}"
export TIER_DATA_POLICY_NAME="${TIER_DATA_POLICY_NAME:-${PREFIX}-tier-data-access}"

export ECR_REPO="${ECR_REPO:-${PREFIX}-athena-mcp}"
export RUNTIME_NAME="${RUNTIME_NAME:-${_PREFIX_}_athena_mcp}"
export GATEWAY_NAME="${GATEWAY_NAME:-${PREFIX}-athena-gw}"
export GATEWAY_TARGET_NAME="${GATEWAY_TARGET_NAME:-${PREFIX}-athena-target}"
export INTERCEPTOR_FUNCTION_NAME="${INTERCEPTOR_FUNCTION_NAME:-${PREFIX}-gateway-interceptor}"
export RATE_LIMIT_ID="${RATE_LIMIT_ID:-${PREFIX}-per-user-requests}"

# CloudFormation stack names. Stack names are identities, so keep them stable across
# template edits or renumbering -- a rename here forces CloudFormation to replace every
# resource. Change them by setting the environment variable, not by editing the file.
export STACK_DATALAKE="${STACK_DATALAKE:-${PREFIX}-datalake}"
export STACK_ROLES="${STACK_ROLES:-${PREFIX}-roles}"
export STACK_LF="${STACK_LF:-${PREFIX}-lakeformation}"
export STACK_ECR="${STACK_ECR:-${PREFIX}-ecr}"
export STACK_INTERCEPTOR="${STACK_INTERCEPTOR:-${PREFIX}-interceptor}"
export STACK_RUNTIME="${STACK_RUNTIME:-${PREFIX}-runtime}"
export STACK_GATEWAY="${STACK_GATEWAY:-${PREFIX}-gateway}"
export STACK_TARGET="${STACK_TARGET:-${PREFIX}-target}"

# The server reads this too, so its own log lines and STS session names carry the
# same prefix as the AWS resources.
export RESOURCE_PREFIX="${PREFIX}"

# Columns the business tier must not see. Owned by scripts/schema.py; this is only
# here so a human reader of config.env can see the demo's actual policy at a glance.
export RESTRICTED_COLUMNS="customer_id,ssn_last4,rate"

# --- Okta: identity and the on-behalf-of token exchange -----------------------
# The whole flow depends on the IdP implementing RFC 8693 token exchange. That is what
# lets the gateway swap the caller's token for a downstream-scoped one carrying the same
# user. An IdP without token exchange forces a different topology: SigV4 from gateway to
# runtime plus a scoped tier header, with the gateway asserting the tier rather than the
# user's own token carrying it.
#
# Non-secret values only. The client secret lives in Secrets Manager; the scripts read
# it from there at run time so nothing sensitive is committed.
#
# SET THESE THREE FOR YOUR OWN OKTA ORG before running deploy.sh. The issuer is your
# custom authorization server, not the org root: https://<your-org>.okta.com/oauth2/<as-id>
export OKTA_ISSUER="${OKTA_ISSUER:-https://<your-org>.okta.com/oauth2/<authorization-server-id>}"
# The LOGIN app. Public, PKCE, no secret. Used only by clients -- the MCP client and the
# CLI scripts -- and never referenced by any AWS resource: the gateway and runtime match
# on audience, not on client id, because Okta puts the client identity in "cid" where
# AllowedClients cannot see it.
export OKTA_SPA_CLIENT_ID="${OKTA_SPA_CLIENT_ID:-<okta-login-app-client-id>}"
# The SERVICE app. Confidential, grants [client_credentials, token-exchange]. This is
# the agent's own identity: AgentCore Identity authenticates as this client to run the
# exchange.
export OKTA_SERVICE_CLIENT_ID="${OKTA_SERVICE_CLIENT_ID:-<okta-service-app-client-id>}"
# Its secret, by reference. Stored in Secrets Manager as {"client_secret": "..."} so the
# value never lands in a template, a stack parameter or this file.
export OKTA_CLIENT_SECRET_NAME="${OKTA_CLIENT_SECRET_NAME:-${PREFIX}/okta-obo-client-secret}"
export OKTA_OBO_PROVIDER="${OKTA_OBO_PROVIDER:-${PREFIX}-okta-obo}"
# "create" lets the target stack own the credential provider, which is what a fresh
# build should do -- leave it alone unless you already have one. "adopt" points at a
# provider that exists outside CloudFormation, e.g. one made by hand in the console:
# creating it again would fail on the duplicate name.
#
# This is deliberately explicit. Deciding it by looking up the name breaks idempotency:
# the second run finds the provider the stack created, switches to adopt, and the
# provider is deleted out from under the target.
export OKTA_OBO_PROVIDER_MODE="${OKTA_OBO_PROVIDER_MODE:-create}"
# Only needed to adopt a provider whose name differs from OKTA_OBO_PROVIDER; otherwise
# the ARN is derived from the account, region and name.
export OKTA_OBO_PROVIDER_ARN="${OKTA_OBO_PROVIDER_ARN:-}"
# Audience the exchange must request. Single-AS exchange, so it matches the inbound
# audience; re-scoping to a different audience needs a second AS plus trusted servers.
export OKTA_AUDIENCE="${OKTA_AUDIENCE:-agentcore-gateway-okta-app}"
# Okta grants the exchange only when a scope is requested and no actor token is sent:
# its access policy rules match on requested scopes, so a scopeless exchange matches
# nothing and is denied. This must be a scope your authorization server defines.
export OKTA_EXCHANGE_SCOPE="${OKTA_EXCHANGE_SCOPE:-api}"
export OKTA_LOGIN_SCOPE="${OKTA_LOGIN_SCOPE:-openid api}"
export OKTA_GROUPS_CLAIM="${OKTA_GROUPS_CLAIM:-groups}"
# Path is /oauth/callback, not /callback, to match Kiro's MCP OAuth callback path. The
# Okta app registers one wildcard, http://localhost:*/oauth/callback, so the same rule
# covers Kiro on whatever port it picks and these scripts on a fixed one.
export OKTA_REDIRECT_URI="${OKTA_REDIRECT_URI:-http://localhost:8400/oauth/callback}"
